{
  "name": "rasalytics",
  "version": "1.0.0",
  "module": "packages/sentiment-core/src/index.ts",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "setup:skills": "bun run tools/scripts/setup-skills.ts",
    "deploy:website": "bash apps/web/deploy-website.sh",
    "dev:worker": "wrangler dev apps/worker/worker.ts",
    "dev:website": "bunx serve apps/web/public",
    "lint:html": "markuplint apps/web/public/index.html",
    "lint:seo": "bun run apps/web/seo-lint.js",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@markuplint/html-spec": "5.6.1",
    "@types/bun": "1.4.4",
    "@types/sentiment": "5.0.4",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "markuplint": "5.6.1",
    "prettier": "3.10.1",
    "wrangler": "4.162.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "emoji-emotion": "3.0.1",
    "franc-min": "6.2.0",
    "natural": "8.2.6",
    "p-limit": "^7.3.3",
    "sentiment": "5.0.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "// sharp": "justification: sharp requires postinstall to download and compile native libvips binaries for image processing",
  "overrides": {
    "protobufjs": ">=7.3.0",
    "uuid": ">=13.0.1"
  }
}
